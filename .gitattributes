# 统一换行符：仓库内存 LF，检出时按平台转换
* text=auto

# 文本
*.md    text
*.py    text
*.yaml  text
*.yml   text
*.csv   text
*.txt   text

# 二进制（禁止自动换行转换与 diff）
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text
*.pyc   binary

# R2 科学源码指纹按原始字节生成；保留发布时的换行字节
src/** -text

# Frozen R2 file hashes must survive cross-platform checkout.
matlab/plot_results.m -text
results/release_20261113_r2/** -text
results/caliber_R2/** -text
tools/caliber_r2.py -text
